{
  // TypeScript (#103) : vérification seule (noEmit), esbuild compile au build. Tous les fichiers de js/ sont en .ts,
  // vérifiés en mode strict ; js/types.d.ts décrit les noms globaux (CMS, MapLibre, données du ciel).
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["js/**/*.ts"]
}
