{
  // TypeScript (#103) : vérification seule (noEmit), esbuild compile. Migration fichier par fichier : les fichiers
  // .ts sont vérifiés en mode strict, les .js restants sont lus pour leurs types mais pas vérifiés (checkJs: false).
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["js/**/*.ts", "js/**/*.js"]
}
